class Solution {
public:
    vector<string> letterCombinations(string digits) {
       vector<string> res;
       if (digits.empty()){
            return res;
       }
       unordered_map<char, string> digitToChar = {
            {'2', "abc"}, {'3', "def"}, {'4', "ghi"},
            {'5', "jkl"}, {'6', "mno"}, {'7', "pqrs"},
            {'8', "tuv"}, {'9', "wxyz"}
        };
       string curStr="";
       auto backtrack=[&](auto& self, int i)->void{
        if(curStr.length()==digits.length()){
            res.push_back(curStr);
            return;
        }
        for(char c:digitToChar[digits[i]]){
            curStr.push_back(c);
            self(self,i+1);
            curStr.pop_back();
        }
       };
       backtrack(backtrack,0);
       return res;
        
    }
};
