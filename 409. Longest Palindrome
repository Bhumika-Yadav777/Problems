class Solution {
public:
    int longestPalindrome(string s) {
        std::unordered_map<char, int> counts;
        for(char c:s){
            counts[c]++;
        }
        int length=0;
        bool has_odd=false;
        for(auto const& [character,count]:counts){
            length+=(count/2)*2;
            if(count%2!=0){
                has_odd=true;
            }
        }
        if(has_odd){
            length+=1;
        }
        return length;
    }
};
