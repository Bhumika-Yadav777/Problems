#include <vector>
#include <algorithm>

class Solution {
private:
    struct Element {
        int value;
        int digit_sum;
        int original_index;
    };

    int getDigitSum(int num) {
        int sum = 0;
        while (num > 0) {
            sum += num % 10;
            num /= 10;
        }
        return sum;
    }

public:
    int minSwaps(std::vector<int>& nums) {
        int n = nums.size();
        std::vector<Element> elements(n);

        for (int i = 0; i < n; ++i) {
            elements[i] = {nums[i], getDigitSum(nums[i]), i};
        }

        std::sort(elements.begin(), elements.end(), [](const Element& a, const Element& b) {
            if (a.digit_sum != b.digit_sum) {
                return a.digit_sum < b.digit_sum;
            }
            return a.value < b.value;
        });

        std::vector<bool> visited(n, false);
        int swaps = 0;

        for (int i = 0; i < n; ++i) {
            if (visited[i] || elements[i].original_index == i) {
                continue;
            }

            int cycle_size = 0;
            int j = i;

            while (!visited[j]) {
                visited[j] = true;
                j = elements[j].original_index;
                cycle_size++;
            }

            if (cycle_size > 0) {
                swaps += (cycle_size - 1);
            }
        }

        return swaps;
    }
};

