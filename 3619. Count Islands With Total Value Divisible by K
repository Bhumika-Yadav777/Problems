#include <vector>

using namespace std;

class Solution {
public:
    int countIslands(vector<vector<int>>& grid, int k) {
        int m = grid.size();
        if (m == 0) return 0;
        int n = grid[0].size();
        int divisibleIslandCount = 0;

        // Lambda helper for Depth-First Search (DFS)
        // Uses long long to safely avoid potential integer overflow for large grid values
        auto dfs = [&](auto& self, int r, int c) -> long long {
            // Base cases: boundary checks and water/visited cell checks
            if (r < 0 || r >= m || c < 0 || c >= n || grid[r][c] <= 0) {
                return 0;
            }
            
            long long currentSum = grid[r][c];
            
            // Mark the current cell as visited by changing its value to 0
            grid[r][c] = 0; 
            
            // Explore all 4 cardinal directions and accumulate their values
            currentSum += self(self, r + 1, c);
            currentSum += self(self, r - 1, c);
            currentSum += self(self, r, c + 1);
            currentSum += self(self, r, c - 1);
            
            return currentSum;
        };

        // Traverse the entire grid to discover unvisited land segments
        for (int i = 0; i < m; ++i) {
            for (int j = 0; j < n; ++j) {
                if (grid[i][j] > 0) {
                    long long islandTotal = dfs(dfs, i, j);
                    
                    // Verify if the total sum of the island is divisible by k
                    if (islandTotal % k == 0) {
                        divisibleIslandCount++;
                    }
                }
            }
        }

        return divisibleIslandCount;
    }
};

