class Solution {
public:
    int lengthOfLastWord(string s) {
        int length =0;
        for(int i=0;i<s.size();i++){
            if (s[i]!=' '){
                if (i>0 && s[i-1]==' '){
                    length=1;
                }
                else{
                    length++;
                }
            }
        }
        return length;
    }
};
