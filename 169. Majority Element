class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int element = 0;
        int count = 0;
        int i = 0;
        while(i < nums.size()) {
            if(count == 0)
                element = nums[i];

            if(nums[i] == element)
                count++;
            else
                count--;

            i++;
        }
        return element;
    }
};
