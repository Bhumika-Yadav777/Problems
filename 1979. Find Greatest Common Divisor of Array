class Solution {
public:
    int findGCD(vector<int>& nums) {
        int min_num = nums[0];
        int max_num = nums[0];
        for (int i = 1; i < nums.size(); ++i) {
            if (nums[i] < min_num) {
                min_num = nums[i];
            }
            if (nums[i] > max_num) {
                max_num = nums[i];
            }
        }
         return gcd(min_num,max_num);
    }
};
