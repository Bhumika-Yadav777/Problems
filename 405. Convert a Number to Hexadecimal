class Solution {
public:
    string toHex(int num) {
        if (num == 0) return "0";
        std::string hex_map = "0123456789abcdef";
        std::string result = "";
        uint32_t n = num;
        while (n > 0) {
            int last_4_bits = n & 15;       
            result += hex_map[last_4_bits];  
            n >>= 4;                      
        }
        std::reverse(result.begin(), result.end());
        return result;
    }
};
