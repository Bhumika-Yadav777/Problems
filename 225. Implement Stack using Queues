#include <queue>

class MyStack {
private:
    std::queue<int> q1;
    std::queue<int> q2;

public:
    MyStack() {
        // Constructor requires no manual initialization
    }
    
    // O(n) time complexity
    void push(int x) {
        // Push the new element into the helper queue
        q2.push(x);
        
        // Push all elements from the main queue behind the new element
        while (!q1.empty()) {
            q2.push(q1.front());
            q1.pop();
        }
        
        // Swap q1 and q2 so that q1 becomes the main active queue again
        std::swap(q1, q2);
    }
    
    // O(1) time complexity
    int pop() {
        int top_element = q1.front();
        q1.pop();
        return top_element;
    }
    
    // O(1) time complexity
    int top() {
        return q1.front();
    }
    
    // O(1) time complexity
    bool empty() {
        return q1.empty();
    }
};

