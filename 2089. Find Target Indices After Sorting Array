#include <vector>
#include <algorithm>

class Solution {
public:
    std::vector<int> targetIndices(std::vector<int>& nums, int target) {
        int count_less = 0;
        int count_equal = 0;
        for (int num : nums) {
            if (num < target) {
                count_less++;
            } else if (num == target) {
                count_equal++;
            }
        }
        std::vector<int> result;
        for (int i = 0; i < count_equal; i++) {
            result.push_back(count_less + i);
        }
        return result;
    }
};

