#include <vector>
#include <numeric>
#include <algorithm>
#include <cmath>
class Solution {
public:
    long long maxAlternatingSum(std::vector<int>& nums) {
        int n = nums.size();
        std::vector<long long> squares(n);
        for (int i = 0; i < n; ++i) {
            squares[i] = 1LL * nums[i] * nums[i];
        }
        std::sort(squares.begin(), squares.end());
        int m = n / 2;
        long long min_sum = std::accumulate(squares.begin(), squares.begin() + m, 0LL);
        long long max_sum = std::accumulate(squares.begin() + m, squares.end(), 0LL);
        return max_sum - min_sum;
    }
};

