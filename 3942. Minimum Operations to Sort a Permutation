#include <vector>
#include <algorithm>

class Solution {
public:
    int minOperations(std::vector<int>& nums) {
        int n = nums.size();
        if (n <= 1) return 0;
        int idx = -1;
        for (int i = 0; i < n; ++i) {
            if (nums[i] == 0) {
                idx = i;
                break;
            }
        }

        int min_ops = 1e9; 
        bool is_increasing = true;
        for (int i = 0; i < n; ++i) {
            if (nums[(idx + i) % n] != i) {
                is_increasing = false;
                break;
            }
        }
        if (is_increasing) {
            min_ops = std::min(min_ops, idx);           
            min_ops = std::min(min_ops, n - idx + 2);   
        }
        bool is_decreasing = true;
        for (int i = 0; i < n; ++i) {
            if (nums[(idx - i + n) % n] != i) {
                is_decreasing = false;
                break;
            }
        }
        if (is_decreasing) {
            min_ops = std::min(min_ops, n - idx);       
            min_ops = std::min(min_ops, idx + 2);       
        }
        return min_ops == 1e9 ? -1 : min_ops;
    }
};
