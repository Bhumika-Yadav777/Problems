class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int length = nums.size();
        int i = 0;

        while (i < length) {
            if (nums[i] == target) {
                return i;
            }
            else {
                if (target < nums[i]) {
                    return i;
                }
            }
            i++;
        }
        return i;
    }
};
